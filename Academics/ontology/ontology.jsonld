      {
        "@id": "https://luciamarock.github.io/Academics/ontology#Perceptrum"
      }
    ]
  },
  {
    "@id": "https://luciamarock.github.io/Academics/ontology#SoundingCanvas",
    "@type": [
      "https://luciamarock.github.io/Academics/ontology#AugmentedPainting",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@id": "https://luciamarock.github.io/Academics/ontology#Perceptrum"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The first body of work developed within Perceptrum, establishing Augmented Painting as a new artistic medium in which paintings acquire expanded expressive capabilities through embedded sensing, sound, and computation. They act as interlocutors: static surfaces that negotiate meaning through the tactile presence of the observer."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://luciamarock.github.io/Academics/ontology/examples/sounding-canvas.html"
      }
