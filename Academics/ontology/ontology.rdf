  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#Perceptrum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Group"/>
