<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns="https://luciamarock.github.io/Academics/ontology#"
   xmlns:bibo="http://purl.org/ontology/bibo/"
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:foaf="http://xmlns.com/foaf/0.1/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Perceptrum Ontology</rdfs:label>
    <dcterms:title xml:lang="en">Perceptrum Ontology</dcterms:title>
    <dcterms:description xml:lang="en">A lightweight ontology describing Augmented Physical Objects, Augmented Paintings and Augmented Musical Instruments.</dcterms:description>
    <dcterms:creator rdf:resource="https://luciamarock.github.io/Academics/ontology#LucianoCiamarone"/>
    <dcterms:publisher rdf:resource="https://luciamarock.github.io/Academics/ontology#Perceptrum"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:language rdf:resource="http://id.loc.gov/vocabulary/iso639-1/en"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2026</dcterms:issued>
    <owl:versionIRI rdf:resource="https://luciamarock.github.io/Academics/ontology/versions/1.0"/>
    <owl:versionInfo>1.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#hasExample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">has example</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a concept or class layer to a specific representative individual instance or exemplary resource.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#AugmentedPainting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://luciamarock.github.io/Academics/ontology#AugmentedPhysicalObject"/>
    <rdfs:label xml:lang="en">Augmented Painting</rdfs:label>
    <owl:sameAs rdf:resource="https://www.wikidata.org/wiki/Q137104541"/>
    <rdfs:isDefinedBy rdf:resource="https://luciamarock.github.io/Academics/ontology/classes/augmented-painting.html"/>
    <rdfs:seeAlso rdf:resource="https://www.perceptrum.net/ontology/augmented-painting.html"/>
    <introducedBy rdf:resource="https://luciamarock.github.io/Academics/ontology#Perceptrum"/>
    <hasExample rdf:resource="https://luciamarock.github.io/Academics/ontology#SoundingCanvas"/>
    <rdfs:comment xml:lang="en">An ontological category in contemporary art defining an art form that combines traditional painting with embedded technology, sensors, and artificial intelligence to create interactive, responsive, and networked experiences where touch and visual interaction generate evolving sounds and behaviors.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#AugmentedPhysicalObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Augmented Physical Object</rdfs:label>
    <owl:sameAs rdf:resource="https://www.wikidata.org/wiki/Q138713278"/>
    <rdfs:isDefinedBy rdf:resource="https://luciamarock.github.io/Academics/ontology/classes/augmented-physical-object.html"/>
    <introducedBy rdf:resource="https://luciamarock.github.io/Academics/ontology#Perceptrum"/>
    <hasExample rdf:resource="https://luciamarock.github.io/Academics/ontology#InteractiveStageSetElement"/>
    <rdfs:comment xml:lang="en">Physical objects enhanced with embedded computational systems that enable responsive, interactive behavior through human gesture. Unlike traditional objects whose behavior is passive and fixed, augmented physical objects introduce a layer of computational agency that allows them to participate in interaction.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#FeedGuitar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://luciamarock.github.io/Academics/ontology#AugmentedMusicalInstrument"/>
    <rdfs:label xml:lang="en">Feed Guitar</rdfs:label>
    <owl:sameAs rdf:resource="https://www.wikidata.org/wiki/Q138757459"/>
    <rdfs:isDefinedBy rdf:resource="https://luciamarock.github.io/Academics/ontology/examples/feed-guitar.html"/>
    <rdfs:seeAlso rdf:resource="https://luciamarock.github.io/Projects/FeedGuitar.html"/>
    <dcterms:creator rdf:resource="https://luciamarock.github.io/Academics/ontology#LucianoCiamarone"/>
    <documentedIn rdf:resource="https://luciamarock.github.io/Academics/ontology#EnvironmentLikeStrings"/>
    <rdfs:comment xml:lang="en">An augmented musical instrument created by Luciano Ciamarone for his Master's Degree thesis at CRM.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#MagneticResonatorPiano">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://luciamarock.github.io/Academics/ontology#AugmentedMusicalInstrument"/>
    <rdfs:label xml:lang="en">Magnetic Resonator Piano</rdfs:label>
    <owl:sameAs rdf:resource="https://www.wikidata.org/wiki/Q116953917"/>
    <rdfs:isDefinedBy rdf:resource="https://luciamarock.github.io/Academics/ontology/examples/magnetic-resonator-piano.html"/>
    <rdfs:seeAlso rdf:resource="https://andrewmcpherson.org/project/mrp"/>
    <rdfs:comment xml:lang="en">A hybrid acoustic-electronic instrument augmenting the grand piano.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#DoraMoteque">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
