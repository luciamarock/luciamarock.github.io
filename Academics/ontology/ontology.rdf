    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://purl.org/ontology/bibo/Chapter"/>
    <rdfs:label xml:lang="en">Environment like strings</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://luciamarock.github.io/Academics/ontology/publications/environment-like-strings.html"/>
    <dcterms:creator rdf:resource="https://luciamarock.github.io/Academics/ontology#LucianoCiamarone"/>
    <dcterms:isPartOf rdf:resource="https://luciamarock.github.io/Academics/ontology#MusiqueEtEcologiesDuSon"/>
    <dcterms:identifier>doi:10.6084/m9.figshare.30903413</dcterms:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#MusiqueEtEcologiesDuSon">
