    <foaf:member rdf:resource="https://luciamarock.github.io/Academics/ontology#DoraMoteque"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#SoundingCanvasIS22025">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://purl.org/ontology/bibo/AcademicArticle"/>
    <rdfs:label xml:lang="en">Sounding Canvas: A Networked Interactive Painting System Based on Touch, Sound, and Machine Learning</rdfs:label>
    <owl:sameAs rdf:resource="https://www.wikidata.org/wiki/Q137426267"/>
    <rdfs:isDefinedBy rdf:resource="https://luciamarock.github.io/Academics/ontology/publications/sounding-canvas-is22025.html"/>
    <dcterms:creator rdf:resource="https://luciamarock.github.io/Academics/ontology#Perceptrum"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcterms:issued>
    <dcterms:bibliographicCitation xml:lang="en">Presented at the 2025 IEEE 6th International Symposium on the Internet of Sounds (IS2) - L'Aquila, Italy.</dcterms:bibliographicCitation>
    <dcterms:identifier>doi:10.1109/IS264627.2025.11284659</dcterms:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#SoundingCanvasNIME2026">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://purl.org/ontology/bibo/AcademicArticle"/>
    <rdfs:label xml:lang="en">Sounding Canvas: A Networked Social Artwork Bridging Distant Communities through Tactile Interaction</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://luciamarock.github.io/Academics/ontology/publications/sounding-canvas-nime2026.html"/>
    <dcterms:creator rdf:resource="https://luciamarock.github.io/Academics/ontology#Perceptrum"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2026</dcterms:issued>
    <dcterms:bibliographicCitation xml:lang="en">Presented at New Interfaces for Musical Expression (NIME) - London, UK.</dcterms:bibliographicCitation>
    <dcterms:identifier>doi:10.5281/zenodo.20782028</dcterms:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#FeedDrum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://luciamarock.github.io/Academics/ontology#AugmentedMusicalInstrument"/>
    <rdfs:label xml:lang="en">Feed-Drum</rdfs:label>
    <owl:sameAs rdf:resource="https://www.wikidata.org/wiki/Q5441166"/>
    <rdfs:isDefinedBy rdf:resource="https://luciamarock.github.io/Academics/ontology/examples/feed-drum.html"/>
    <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Feed-Drum"/>
    <dcterms:creator rdf:resource="https://luciamarock.github.io/Academics/ontology#MichelangeloLupone"/>
    <dcterms:contributor rdf:resource="https://luciamarock.github.io/Academics/ontology#CentroRicercheMusicali"/>
    <dcterms:contributor rdf:resource="https://luciamarock.github.io/Academics/ontology#IstitutoGramma"/>
    <rdfs:comment xml:lang="en">An imperial bass drum with a system of electronic conditioning of the skin conceived by composer Michelangelo Lupone.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#AugmentedMusicalInstrument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://luciamarock.github.io/Academics/ontology#AugmentedPhysicalObject"/>
    <rdfs:label xml:lang="en">Augmented Musical Instrument</rdfs:label>
    <owl:sameAs rdf:resource="https://www.wikidata.org/wiki/Q138713305"/>
    <rdfs:isDefinedBy rdf:resource="https://luciamarock.github.io/Academics/ontology/classes/augmented-musical-instrument.html"/>
    <introducedBy rdf:resource="https://luciamarock.github.io/Academics/ontology#MichelangeloLupone"/>
    <hasExample rdf:resource="https://luciamarock.github.io/Academics/ontology#FeedDrum"/>
    <hasExample rdf:resource="https://luciamarock.github.io/Academics/ontology#MagneticResonatorPiano"/>
    <hasExample rdf:resource="https://luciamarock.github.io/Academics/ontology#FeedGuitar"/>
    <rdfs:comment xml:lang="en">Musical instrument extended with sensors, computation, or actuators that modify or enhance its expressive capabilities. These systems expand traditional instrumental interaction by introducing computational mediation between gesture and sound production.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#SoundingCanvas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://luciamarock.github.io/Academics/ontology#AugmentedPainting"/>
    <rdfs:label xml:lang="en">Sounding Canvas</rdfs:label>
    <owl:sameAs rdf:resource="https://www.wikidata.org/wiki/Q136547884"/>
    <rdfs:isDefinedBy rdf:resource="https://luciamarock.github.io/Academics/ontology/examples/sounding-canvas.html"/>
    <rdfs:seeAlso rdf:resource="https://www.perceptrum.net/works/sounding-canvas.html"/>
    <dcterms:creator rdf:resource="https://luciamarock.github.io/Academics/ontology#Perceptrum"/>
    <documentedIn rdf:resource="https://luciamarock.github.io/Academics/ontology#SoundingCanvasIS22025"/>
    <documentedIn rdf:resource="https://luciamarock.github.io/Academics/ontology#SoundingCanvasNIME2026"/>
    <rdfs:comment xml:lang="en">The first body of work developed within Perceptrum, establishing Augmented Painting as a new artistic medium in which paintings acquire expanded expressive capabilities through embedded sensing, sound, and computation. They act as interlocutors: static surfaces that negotiate meaning through the tactile presence of the observer.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#introducedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    <rdfs:label xml:lang="en">introduced by</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a class, conceptual paradigm, or artistic category to the individual, group, or organization that pioneered or originally introduced it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#IstitutoGramma">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    <rdfs:label xml:lang="en">Istituto Gramma, L'Aquila</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#documentedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">documented in</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an artwork instance or an instrument to a research paper or bibliographic resource documenting its system implementation.</rdfs:comment>
    <rdfs:range rdf:resource="http://purl.org/ontology/bibo/Document"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#LucianoCiamarone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <rdfs:label xml:lang="en">Luciano Ciamarone</rdfs:label>
    <foaf:homepage rdf:resource="https://luciamarock.github.io/"/>
    <owl:sameAs rdf:resource="https://www.wikidata.org/wiki/Q138757384"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#InteractiveStageSetElement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://luciamarock.github.io/Academics/ontology#AugmentedPhysicalObject"/>
    <rdfs:label xml:lang="en">Interactive Stage Set Element</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://luciamarock.github.io/Academics/ontology/examples/interactive-stage-set-element.html"/>
    <rdfs:seeAlso rdf:resource="https://luciamarock.github.io/Projects/AccroccoSonic.html"/>
    <dcterms:creator rdf:resource="https://luciamarock.github.io/Academics/ontology#LucianoCiamarone"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</dcterms:created>
    <rdfs:comment xml:lang="en">A unique wooden sculpture designed as a relational scenographic element for dance performances. Its structure and functionality combine acoustic principles with artistic creativity, resulting in a versatile object that can also be connected to external augmented musical instruments.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://luciamarock.github.io/Academics/ontology#MichelangeloLupone">
